<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PythonCoderGame.Setup</AssemblyName>
    <RootNamespace>PythonCoderGame.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\PythonCoderGamePayload.zip" LogicalName="PythonCoderGame.Payload.zip" Condition="Exists('Payload\PythonCoderGamePayload.zip')" />
  </ItemGroup>
</Project>
